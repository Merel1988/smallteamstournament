generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Team {
  id          String   @id @default(cuid())
  name        String
  shortName   String?
  logoUrl     String?
  color       String?
  descriptionNl String?
  descriptionEn String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  players     Player[]
  matchesA    Match[]  @relation("TeamA")
  matchesB    Match[]  @relation("TeamB")
}

model Player {
  id          String    @id @default(cuid())
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  derbyName   String
  number      String
  headshotUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  mvpVotes    MvpVote[]
}

model Match {
  id        String    @id @default(cuid())
  startsAt  DateTime
  poule     String?
  teamAId   String
  teamBId   String
  teamA     Team      @relation("TeamA", fields: [teamAId], references: [id])
  teamB     Team      @relation("TeamB", fields: [teamBId], references: [id])
  scoreA    Int?
  scoreB    Int?
  status    String    @default("scheduled")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  mvpVotes  MvpVote[]
}

model Photo {
  id           String   @id @default(cuid())
  url          String
  thumbUrl     String?
  uploaderName String?
  caption      String?
  createdAt    DateTime @default(now())
}

model MvpVote {
  id        String   @id @default(cuid())
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  voterHash String
  createdAt DateTime @default(now())

  @@unique([voterHash, matchId])
}

model BingoPrompt {
  id       String  @id @default(cuid())
  text     String
  category String?
  active   Boolean @default(true)
}

model HouseRule {
  id    String @id @default(cuid())
  order Int    @default(0)
  title String
  body  String
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// External registration links shown on /aanmelden. Bilingual label/description
// (EN falls back to NL when empty). Hidden by default (visible=false) so a link
// can be prepared ahead of time and switched on manually.
model RegistrationLink {
  id            String   @id @default(cuid())
  order         Int      @default(0)
  url           String
  labelNl       String
  labelEn       String?
  descriptionNl String?
  descriptionEn String?
  visible       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Per-page visibility toggle. `key` is a page key from src/lib/pages.ts
// (e.g. "teams"). A missing row means visible — only hidden pages need a row
// with visible=false. Nav items are filtered and the routes return notFound()
// when hidden.
model PageVisibility {
  key       String   @id
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// History of push notifications sent from /admin/push. Written by sendToAll()
// after each send so organisers can see what went out and how it landed.
model SentNotification {
  id           String   @id @default(cuid())
  title        String
  body         String
  url          String?
  sentCount    Int      @default(0)
  removedCount Int      @default(0)
  failedCount  Int      @default(0)
  errors       String?  // newline-joined failure summaries, null when none
  createdAt    DateTime @default(now())
}

// Editable text layer over next-intl. `key` is a dotted path into the message
// tree (e.g. "Home.countdownLabel"). Absent keys fall back to messages/*.json.
model MessageOverride {
  id        String   @id @default(cuid())
  locale    String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([locale, key])
}

// Draaiboek / vrijwilligersrooster. Lives on an unlisted, noindex page
// (/draaiboek/<DRAAIBOEK_TOKEN>). Times are minutes since midnight on event
// day. `info` is a JSON array of checklist strings. Volunteers are plain names
// (no accounts); a signup links a volunteer to a shift.
model VolunteerTask {
  id        String           @id @default(cuid())
  area      String           // zaal | kantine | officials | algemeen
  name      String
  info      String           @default("[]")
  sortOrder Int              @default(0)
  shifts    VolunteerShift[]
}

model VolunteerShift {
  id      String            @id @default(cuid())
  taskId  String
  task    VolunteerTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  start   Int
  end     Int
  need    Int               @default(1)
  signups VolunteerSignup[]
}

model Volunteer {
  id        String            @id @default(cuid())
  name      String
  teamId    String?           // Team.id when the volunteer skates in the tournament
  createdAt DateTime          @default(now())
  signups   VolunteerSignup[]
}

model VolunteerSignup {
  id          String         @id @default(cuid())
  shiftId     String
  shift       VolunteerShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   Volunteer      @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([shiftId, volunteerId])
}

// Organisation-only lists on the draaiboek page: `kind` is "prep" (timeline
// to the event), "issue" (open questions) or "role" (who is responsible).
model DraaiboekItem {
  id        String  @id @default(cuid())
  kind      String
  fase      String  @default("")
  text      String
  note      String  @default("")
  wie       String  @default("")
  datum     String  @default("")
  done      Boolean @default(false)
  sortOrder Int     @default(0)
}
